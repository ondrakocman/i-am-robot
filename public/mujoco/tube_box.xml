<!--
  Tube-into-box task, modeled on Isaac Lab's PickPlace-FixedBaseUpperBodyIK-G1:
  object on the robot's left, container on its right, success = object resting inside the container
  with the hands pulled back. Robot faces +x, +y is the robot's left, z is up.
-->
<mujoco model="g1_tube_box">
  <include file="g1_upper.xml"/>

  <!-- timestep is overridden at load time by the app (?dt=...) -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <!-- Stiffer-than-default contacts on everything the hands touch (MuJoCo default timeconst is 0.02 s, which
       lets fingers sink a few mm into objects). 0.01 s keeps the required timeconst >= 2*timestep for every
       timestep the app allows (up to 5 ms). priority=1 makes these win over the robot's default geoms. -->
  <default>
    <default class="touchable">
      <geom solref="0.01 1" priority="1"/>
    </default>
    <default class="tube_wall">
      <geom type="box" size="0.001 0.0091 0.07" group="3" solref="0.01 1" priority="1" condim="6" friction="0.7 0.01 0.002"/>
    </default>
  </default>

  <asset>
    <material name="floor" rgba="0.42 0.42 0.44 1"/>
    <material name="table" rgba="0.45 0.35 0.26 1"/>
    <material name="table_leg" rgba="0.3 0.24 0.19 1"/>
    <material name="box" rgba="0.2 0.36 0.62 1"/>
    <material name="tube" rgba="0.72 0.73 0.75 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <!-- Table top at z=0.79, front edge 18 cm in front of the pelvis (the G1 arm only reaches ~35 cm forward) -->
    <body name="table" pos="0.43 0 0">
      <geom name="table_top" class="touchable" type="box" size="0.25 0.5 0.015" pos="0 0 0.775" material="table"/>
      <geom type="box" size="0.02 0.02 0.38" pos="0.21 0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="0.21 -0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="-0.21 0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="-0.21 -0.46 0.38" material="table_leg"/>
    </body>

    <!-- Open box (static). Interior 0.18 x 0.20, walls 7 cm high, sitting on the table top. -->
    <body name="box" pos="0.32 -0.13 0.79">
      <geom name="box_floor" class="touchable" type="box" size="0.1 0.11 0.005" pos="0 0 0.005" material="box"/>
      <geom name="box_wall_front" class="touchable" type="box" size="0.005 0.11 0.035" pos="0.095 0 0.035" material="box"/>
      <geom name="box_wall_back" class="touchable" type="box" size="0.005 0.11 0.035" pos="-0.095 0 0.035" material="box"/>
      <geom name="box_wall_left" class="touchable" type="box" size="0.1 0.005 0.035" pos="0 0.105 0.035" material="box"/>
      <geom name="box_wall_right" class="touchable" type="box" size="0.1 0.005 0.035" pos="0 -0.105 0.035" material="box"/>
    </body>

    <!-- Steel tube: 44 mm outer diameter, 2 mm wall, 14 cm long -> 0.30 kg with hollow-cylinder inertia.
         The bore is real: collision is a ring of 8 thin boxes (a convex hull would fill it), so a finger
         can go inside. Steel on rubber pads mu~0.7; condim 6 adds torsional friction (pinches don't spin)
         and rolling friction (a tube lying on its side stops instead of rolling off the table). -->
    <body name="tube" pos="0.31 0.15 0.861">
      <freejoint name="tube_free"/>
      <inertial pos="0 0 0" mass="0.3" diaginertia="5.56e-4 5.56e-4 1.33e-4"/>
      <geom name="tube" type="cylinder" size="0.022 0.07" contype="0" conaffinity="0" density="0" material="tube"/>
      <geom name="tube_wall0" class="tube_wall" pos="0.0210 0.0000 0" quat="1.000000 0 0 0.000000"/>
      <geom name="tube_wall1" class="tube_wall" pos="0.0148 0.0148 0" quat="0.923880 0 0 0.382683"/>
      <geom name="tube_wall2" class="tube_wall" pos="0.0000 0.0210 0" quat="0.707107 0 0 0.707107"/>
      <geom name="tube_wall3" class="tube_wall" pos="-0.0148 0.0148 0" quat="0.382683 0 0 0.923880"/>
      <geom name="tube_wall4" class="tube_wall" pos="-0.0210 0.0000 0" quat="0.000000 0 0 1.000000"/>
      <geom name="tube_wall5" class="tube_wall" pos="-0.0148 -0.0148 0" quat="-0.382683 0 0 0.923880"/>
      <geom name="tube_wall6" class="tube_wall" pos="-0.0000 -0.0210 0" quat="-0.707107 0 0 0.707107"/>
      <geom name="tube_wall7" class="tube_wall" pos="0.0148 -0.0148 0" quat="-0.923880 0 0 0.382683"/>
    </body>
  </worldbody>
</mujoco>
