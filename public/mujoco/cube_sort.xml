<!--
  Cube sorting: six 3D-printed PLA cubes, two of each colour, into the matching bins (a real bin model,
  assets/bin-source.stl, converted by scripts/convert-object.py). Robot faces +x, +y is the robot's left, z is up.
-->
<mujoco model="g1_cube_sort">
  <include file="g1_upper.xml"/>

  <!-- timestep is overridden at load time by the app (?dt=...) -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="touchable">
      <geom solref="0.01 1" priority="1"/>
    </default>
    <!-- the manipulated objects: priority 2 so their (randomized) friction applies against table, bins and
         hands alike (on a priority tie MuJoCo takes the larger friction, which would hide the randomization) -->
    <default class="object">
      <geom solref="0.01 1" priority="2"/>
    </default>
  </default>

  <asset>
    <material name="floor" rgba="0.42 0.42 0.44 1"/>
    <material name="table" rgba="0.45 0.35 0.26 1"/>
    <material name="table_leg" rgba="0.3 0.24 0.19 1"/>
    <material name="red" rgba="0.85 0.15 0.12 1"/>
    <material name="green" rgba="0.15 0.6 0.25 1"/>
    <material name="blue" rgba="0.12 0.35 0.85 1"/>
    <material name="red_bin" rgba="0.7 0.2 0.18 1"/>
    <material name="green_bin" rgba="0.2 0.5 0.28 1"/>
    <material name="blue_bin" rgba="0.18 0.32 0.68 1"/>
    <mesh name="bin_visual" file="objects/bin/visual.stl"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <body name="table" pos="0.43 0 0">
      <geom name="table_top" class="touchable" type="box" size="0.25 0.5 0.015" pos="0 0 0.775" material="table"/>
      <geom type="box" size="0.02 0.02 0.38" pos="0.21 0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="0.21 -0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="-0.21 0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="-0.21 -0.46 0.38" material="table_leg"/>
    </body>

    <!-- Bins (220 x 180 x 80 mm, base centred at pos): red on the left, green ahead, blue on the right.
         The mesh is visual only; collision is the matching box set below. -->
    <body name="bin_red" pos="0.32 0.31 0.79">
      <geom type="mesh" mesh="bin_visual" contype="0" conaffinity="0" density="0" material="red_bin"/>
      <!-- collision: the bin's walls and floor as solid boxes with the measured 2 mm thickness (outer
           220 x 180 x 80 mm, interior 216 x 176 mm), exactly what the operator sees; boxes have no seams
           for a fingertip to slip through, unlike a convex decomposition of the perforated mesh -->
      <geom name="bin_red_floor" class="touchable" type="box" group="3" size="0.11 0.09 0.001" pos="0 0 0.001"/>
      <geom name="bin_red_wall_x0" class="touchable" type="box" group="3" size="0.001 0.09 0.039" pos="0.109 0 0.041"/>
      <geom name="bin_red_wall_x1" class="touchable" type="box" group="3" size="0.001 0.09 0.039" pos="-0.109 0 0.041"/>
      <geom name="bin_red_wall_y0" class="touchable" type="box" group="3" size="0.11 0.001 0.039" pos="0 0.089 0.041"/>
      <geom name="bin_red_wall_y1" class="touchable" type="box" group="3" size="0.11 0.001 0.039" pos="0 -0.089 0.041"/>
    </body>
    <body name="bin_green" pos="0.45 0.0 0.79">
      <geom type="mesh" mesh="bin_visual" contype="0" conaffinity="0" density="0" material="green_bin"/>
      <!-- collision: the bin's walls and floor as solid boxes with the measured 2 mm thickness (outer
           220 x 180 x 80 mm, interior 216 x 176 mm), exactly what the operator sees; boxes have no seams
           for a fingertip to slip through, unlike a convex decomposition of the perforated mesh -->
      <geom name="bin_green_floor" class="touchable" type="box" group="3" size="0.11 0.09 0.001" pos="0 0 0.001"/>
      <geom name="bin_green_wall_x0" class="touchable" type="box" group="3" size="0.001 0.09 0.039" pos="0.109 0 0.041"/>
      <geom name="bin_green_wall_x1" class="touchable" type="box" group="3" size="0.001 0.09 0.039" pos="-0.109 0 0.041"/>
      <geom name="bin_green_wall_y0" class="touchable" type="box" group="3" size="0.11 0.001 0.039" pos="0 0.089 0.041"/>
      <geom name="bin_green_wall_y1" class="touchable" type="box" group="3" size="0.11 0.001 0.039" pos="0 -0.089 0.041"/>
    </body>
    <body name="bin_blue" pos="0.32 -0.31 0.79">
      <geom type="mesh" mesh="bin_visual" contype="0" conaffinity="0" density="0" material="blue_bin"/>
      <!-- collision: the bin's walls and floor as solid boxes with the measured 2 mm thickness (outer
           220 x 180 x 80 mm, interior 216 x 176 mm), exactly what the operator sees; boxes have no seams
           for a fingertip to slip through, unlike a convex decomposition of the perforated mesh -->
      <geom name="bin_blue_floor" class="touchable" type="box" group="3" size="0.11 0.09 0.001" pos="0 0 0.001"/>
      <geom name="bin_blue_wall_x0" class="touchable" type="box" group="3" size="0.001 0.09 0.039" pos="0.109 0 0.041"/>
      <geom name="bin_blue_wall_x1" class="touchable" type="box" group="3" size="0.001 0.09 0.039" pos="-0.109 0 0.041"/>
      <geom name="bin_blue_wall_y0" class="touchable" type="box" group="3" size="0.11 0.001 0.039" pos="0 0.089 0.041"/>
      <geom name="bin_blue_wall_y1" class="touchable" type="box" group="3" size="0.11 0.001 0.039" pos="0 -0.089 0.041"/>
    </body>

    <!-- Cubes: 5 cm printed PLA, ~60 g with infill; positions are set at reset -->
    <body name="cube0" pos="0.26 0.05 0.816">
      <freejoint name="cube0_free"/>
      <geom name="cube0" class="object" type="box" size="0.025 0.025 0.025" mass="0.06" condim="4" friction="0.5 0.005 0.0002" material="red"/>
    </body>
    <body name="cube1" pos="0.33 0.05 0.816">
      <freejoint name="cube1_free"/>
      <geom name="cube1" class="object" type="box" size="0.025 0.025 0.025" mass="0.06" condim="4" friction="0.5 0.005 0.0002" material="red"/>
    </body>
    <body name="cube2" pos="0.40 0.05 0.816">
      <freejoint name="cube2_free"/>
      <geom name="cube2" class="object" type="box" size="0.025 0.025 0.025" mass="0.06" condim="4" friction="0.5 0.005 0.0002" material="green"/>
    </body>
    <body name="cube3" pos="0.26 -0.05 0.816">
      <freejoint name="cube3_free"/>
      <geom name="cube3" class="object" type="box" size="0.025 0.025 0.025" mass="0.06" condim="4" friction="0.5 0.005 0.0002" material="green"/>
    </body>
    <body name="cube4" pos="0.33 -0.05 0.816">
      <freejoint name="cube4_free"/>
      <geom name="cube4" class="object" type="box" size="0.025 0.025 0.025" mass="0.06" condim="4" friction="0.5 0.005 0.0002" material="blue"/>
    </body>
    <body name="cube5" pos="0.40 -0.05 0.816">
      <freejoint name="cube5_free"/>
      <geom name="cube5" class="object" type="box" size="0.025 0.025 0.025" mass="0.06" condim="4" friction="0.5 0.005 0.0002" material="blue"/>
    </body>
  </worldbody>
</mujoco>
