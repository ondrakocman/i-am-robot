<!--
  Package sorting: four parcels in the middle of the table, a bin on each side. Red labels go left (+y),
  blue labels go right (-y). Robot faces +x, +y is the robot's left, z is up.
-->
<mujoco model="g1_package_sort">
  <include file="g1_upper.xml"/>

  <!-- timestep is overridden at load time by the app (?dt=...) -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="touchable">
      <geom solref="0.01 1" priority="1"/>
    </default>
    <default class="label">
      <geom type="box" size="0.02 0.014 0.001" pos="0 0 0.051" contype="0" conaffinity="0" density="0"/>
    </default>
  </default>

  <asset>
    <material name="floor" rgba="0.42 0.42 0.44 1"/>
    <material name="table" rgba="0.45 0.35 0.26 1"/>
    <material name="table_leg" rgba="0.3 0.24 0.19 1"/>
    <material name="bin" rgba="0.36 0.37 0.4 1"/>
    <material name="cardboard" rgba="0.62 0.47 0.3 1"/>
    <material name="red" rgba="0.85 0.15 0.12 1"/>
    <material name="blue" rgba="0.12 0.35 0.85 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <body name="table" pos="0.43 0 0">
      <geom name="table_top" class="touchable" type="box" size="0.25 0.5 0.015" pos="0 0 0.775" material="table"/>
      <geom type="box" size="0.02 0.02 0.38" pos="0.21 0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="0.21 -0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="-0.21 0.46 0.38" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.38" pos="-0.21 -0.46 0.38" material="table_leg"/>
    </body>

    <!-- Bins: interior 0.20 x 0.12, walls 5 cm high, on the table top, 10 cm clear of the parcel slots -->
    <body name="bin_left" pos="0.31 0.27 0.79">
      <geom name="bin_left_floor" class="touchable" type="box" size="0.1 0.06 0.005" pos="0 0 0.005" material="bin"/>
      <geom name="bin_left_wall_front" class="touchable" type="box" size="0.005 0.06 0.025" pos="0.095 0 0.025" material="bin"/>
      <geom name="bin_left_wall_back" class="touchable" type="box" size="0.005 0.06 0.025" pos="-0.095 0 0.025" material="bin"/>
      <geom name="bin_left_wall_l" class="touchable" type="box" size="0.1 0.005 0.025" pos="0 0.065 0.025" material="bin"/>
      <geom name="bin_left_wall_r" class="touchable" type="box" size="0.1 0.005 0.025" pos="0 -0.065 0.025" material="bin"/>
      <geom name="label_bin_left" class="label" pos="0 0.065 0.052" material="red"/>
    </body>
    <body name="bin_right" pos="0.31 -0.27 0.79">
      <geom name="bin_right_floor" class="touchable" type="box" size="0.1 0.06 0.005" pos="0 0 0.005" material="bin"/>
      <geom name="bin_right_wall_front" class="touchable" type="box" size="0.005 0.06 0.025" pos="0.095 0 0.025" material="bin"/>
      <geom name="bin_right_wall_back" class="touchable" type="box" size="0.005 0.06 0.025" pos="-0.095 0 0.025" material="bin"/>
      <geom name="bin_right_wall_l" class="touchable" type="box" size="0.1 0.005 0.025" pos="0 0.065 0.025" material="bin"/>
      <geom name="bin_right_wall_r" class="touchable" type="box" size="0.1 0.005 0.025" pos="0 -0.065 0.025" material="bin"/>
      <geom name="label_bin_right" class="label" pos="0 -0.065 0.052" material="blue"/>
    </body>

    <!-- Parcels: 6 x 4.5 x 10 cm cardboard boxes, 150 g, with a label on top (visual only). Positions are set at
         reset; condim 4 adds torsional friction so a pinched parcel doesn't spin. -->
    <body name="parcel0" pos="0.27 0.05 0.841">
      <freejoint name="parcel0_free"/>
      <geom name="parcel0" class="touchable" type="box" size="0.03 0.0225 0.05" mass="0.15" condim="4" friction="0.8 0.01 0.0005" material="cardboard"/>
      <geom name="label0" class="label" material="red"/>
    </body>
    <body name="parcel1" pos="0.34 0.05 0.841">
      <freejoint name="parcel1_free"/>
      <geom name="parcel1" class="touchable" type="box" size="0.03 0.0225 0.05" mass="0.15" condim="4" friction="0.8 0.01 0.0005" material="cardboard"/>
      <geom name="label1" class="label" material="red"/>
    </body>
    <body name="parcel2" pos="0.27 -0.05 0.841">
      <freejoint name="parcel2_free"/>
      <geom name="parcel2" class="touchable" type="box" size="0.03 0.0225 0.05" mass="0.15" condim="4" friction="0.8 0.01 0.0005" material="cardboard"/>
      <geom name="label2" class="label" material="blue"/>
    </body>
    <body name="parcel3" pos="0.34 -0.05 0.841">
      <freejoint name="parcel3_free"/>
      <geom name="parcel3" class="touchable" type="box" size="0.03 0.0225 0.05" mass="0.15" condim="4" friction="0.8 0.01 0.0005" material="cardboard"/>
      <geom name="label3" class="label" material="blue"/>
    </body>
  </worldbody>
</mujoco>
